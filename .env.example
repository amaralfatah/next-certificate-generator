# Copy to .env.local. Every service is optional locally: without it Sararia Certificates falls back
# to a local stand-in so the whole flow still works on a laptop.

# Public base URL (used in QR codes, verification links and the Google callback).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs sessions, download links and local file URLs. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Postgres. neon.tech URLs use the Neon serverless driver; any other URL uses node-postgres.
# Empty: embedded PGlite database in .data/pglite (migrated automatically).
DATABASE_URL=

# Neon Auth (Managed Better Auth) with Google sign-in. `neon deploy` fills NEON_AUTH_BASE_URL.
# Empty in development: an email-only dev login is shown instead.
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3 API). `neon deploy` fills the AWS_* variables once neon.ts declares the bucket.
# Takes priority over R2.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=sararia-certificates-bucket

# Cloudflare R2 (private bucket). Empty: files are stored in .data/files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# SMTP (Gmail: enable 2-step verification, then create an App Password at myaccount.google.com/apppasswords).
# Takes priority over Resend. Gmail allows roughly 500 emails/day.
SMTP_USER=
SMTP_PASSWORD=
# Resend (alternative, needs a verified domain). With neither SMTP nor Resend: emails are logged to the console and marked "Dilewati".
RESEND_API_KEY=
MAIL_FROM="Sararia Certificates <sertifikat@certificates.sararia.com>"
# Daily send cap shown on the dashboard (Resend free tier: 100/day).
EMAIL_DAILY_LIMIT=100

# Cloudflare Turnstile. Empty: the challenge is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
